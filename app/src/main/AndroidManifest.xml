<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Visibilidad de paquetes (Android 11+): sin esto, getPackageInfo() sobre
        la app de Shizuku lanza NameNotFoundException aunque esté instalada, y
        no podríamos distinguir "no instalado" de "instalado pero detenido".
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!--
        Necesario para mostrar el NOMBRE de los paquetes del sistema (y de los que
        están en la papelera) en Android 11+. Los comandos `pm` no lo necesitan:
        corren como shell. Google Play restringe este permiso; para distribución
        fuera de Play (GitHub/F-Droid) no hay problema.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Servicio en primer plano durante la cuenta atrás de DPI/resolución. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: para mostrar la notificación con "Mantener / Revertir". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ElCondorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElCondor"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ElCondor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Provider obligatorio de Shizuku. Cuando el servicio de Shizuku arranca
            (o cuando la app se abre), Shizuku llama a este provider para
            "inyectar" su binder en nuestro proceso. Los atributos deben ser
            EXACTAMENTE estos:
              - authorities = ${applicationId}.shizuku
              - exported=true + permission INTERACT_ACROSS_USERS_FULL: solo
                procesos del sistema/shell (como Shizuku) pueden invocarlo.
              - multiprocess=false: el binder vive en el proceso principal.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            Mosaico de Ajustes rápidos. TOGGLEABLE_TILE hace que el sistema lo
            anuncie como interruptor (accesibilidad y estilo on/off).
        -->
        <service
            android:name=".tile.AnimationSpeedTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_speed"
            android:label="@string/tile_animations"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!--
            Cuenta atrás de seguridad. "specialUse" (Android 14+) porque ningún tipo
            estándar encaja; la propiedad explica el motivo para revisión.
        -->
        <service
            android:name=".display.DisplaySafetyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Revierte automáticamente cambios de DPI/resolución no confirmados en 10 segundos" />
        </service>
    </application>
</manifest>
